# ==========================================
# RFC TASK AGENT - LOCAL CONFIGURATION
# ==========================================

# Server Port (Default: 3000)
PORT=3000

# Optional Browser Target URL (Default fallback for local browser automation)
# If left empty, URLs can be defined per-workflow or entered manually in the Browser panel.
# TARGET_URL=https://example.com

# Optional System Administrator Integrations (NOT required for normal operator session)
# TELEGRAM_BOT_TOKEN=
# PHONE_PROVIDER_BOT_TOKEN=
